# ============================================================
# Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to version control!

# ============================================================
# LLM Configuration
# ============================================================

# LLM Provider: openai_compatible (supports any OpenAI-compatible API)
LLM_PROVIDER=openai_compatible

# Your API Key
# - 火山方舟 (Volcano Ark): Get from https://console.volcengine.com/ark
# - 通义千问: Get from https://dashscope.console.aliyun.com/
# - DeepSeek: Get from https://platform.deepseek.com/
LLM_API_KEY=sk-your-api-key-here

# API Base URL (OpenAI compatible endpoint)
# - 火山方舟: https://ark.cn-beijing.volces.com/api/v3
# - 通义千问兼容模式: https://dashscope.aliyuncs.com/compatible-mode/v1
# - DeepSeek: https://api.deepseek.com/v1
# - 智谱AI: https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Chat model name
# - 火山方舟 (豆包): doubao-pro-32k-241028
# - 通义千问: qwen-plus
# - DeepSeek: deepseek-chat
LLM_MODEL=doubao-pro-32k-241028

# Embedding model name (for RAG vectorization)
# - 火山方舟: doubao-embedding-240715
# - 通义千问: text-embedding-v2
EMBEDDING_MODEL=doubao-embedding-240715

# ============================================================
# Application Settings (optional)
# ============================================================

# App name
APP_NAME=IT服务智能助手

# Environment: development / production
ENVIRONMENT=production

# Vector DB collection name
CHROMA_COLLECTION_NAME=it_knowledge_base

# Document chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Number of docs to retrieve in RAG
RAG_TOP_K=4
